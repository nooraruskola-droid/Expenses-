<script>
  const CATEGORIES = [
    { id: 'nt',          label: 'N&T',         short: 'NT', colour: '#6C6CE5' },
    { id: 'food',        label: 'Food',        short: 'F',  colour: '#3E9B72' },
    { id: 'eatout',      label: 'Eat out',     short: 'EO', colour: '#D97742' },
    { id: 'household',   label: 'Household',   short: 'H',  colour: '#8C7B62' },
    { id: 'necessities', label: 'Necessities', short: 'N',  colour: '#3E86C4' },
    { id: 'shopping',    label: 'Shopping',    short: 'S',  colour: '#B24C87' },
    { id: 'other',       label: 'Other',       short: 'O',  colour: '#6F7D82' }
  ];

  const KEY = 'expenses-v1';
  const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  const SHORT = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

  let entries = [];
  let picked = null;
  let confirming = null;
  let view = new Date();

  const $ = id => document.getElementById(id);
  const cat = id => CATEGORIES.find(c => c.id === id) || CATEGORIES[6];
  const catByLabel = l => CATEGORIES.find(c => c.label.toLowerCase() === String(l).trim().toLowerCase());
  const money = n => '$' + n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  const localISO = d => d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  const esc = s => String(s).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));

  function prettyDate(iso) {
    const [y, m, d] = iso.split('-').map(Number);
    if (iso === localISO(new Date())) return 'Today';
    const yest = new Date(); yest.setDate(yest.getDate() - 1);
    if (iso === localISO(yest)) return 'Yesterday';
    return d + ' ' + SHORT[m - 1] + (y !== new Date().getFullYear() ? ' ' + y : '');
  }

  function load() {
    try {
      const raw = localStorage.getItem(KEY);
      if (raw) entries = JSON.parse(raw);
    } catch (e) { entries = []; }
  }

  function save() {
    try {
      localStorage.setItem(KEY, JSON.stringify(entries));
    } catch (e) {
      $('hint').textContent = 'Could not save on this device. Export to CSV before you close the page.';
    }
  }

  CATEGORIES.forEach(c => {
    const b = document.createElement('button');
    b.className = 'chip';
    b.type = 'button';
    b.style.setProperty('--c', c.colour);
    b.setAttribute('aria-pressed', 'false');
    b.innerHTML = '<i class="dot"></i>' + c.label;
    b.onclick = () => {
      picked = picked === c.id ? null : c.id;
      [...$('chips').children].forEach((el, i) => el.setAttribute('aria-pressed', String(CATEGORIES[i].id === picked)));
      checkReady();
    };
    $('chips').appendChild(b);
  });

  function parseAmount() {
    const n = parseFloat($('amount').value.replace(',', '.').replace(/[^0-9.]/g, ''));
    return isFinite(n) && n > 0 ? Math.round(n * 100) / 100 : null;
  }

  function checkReady() {
    const amt = parseAmount(), ok = amt !== null && picked;
    $('add').disabled = !ok;
    $('sub').textContent = ok
      ? cat(picked).label + ' on ' + prettyDate($('date').value).toLowerCase()
      : amt === null ? 'Enter an amount and pick a category' : 'Pick a category';
  }

  function addEntry() {
    const amount = parseAmount();
    if (amount === null || !picked) return;
    entries.push({
      id: Date.now() + '-' + Math.random().toString(36).slice(2, 7),
      date: $('date').value || localISO(new Date()),
      amount: amount,
      note: $('note').value.trim(),
      category: picked
    });
    $('amount').value = '';
    $('note').value = '';
    picked = null;
    [...$('chips').children].forEach(el => el.setAttribute('aria-pressed', 'false'));
    view = new Date($('date').value + 'T12:00:00');
    checkReady();
    save();
    render();
    $('amount').focus();
  }

  $('amount').addEventListener('input', checkReady);
  $('amount').addEventListener('blur', () => { const n = parseAmount(); if (n !== null) $('amount').value = n.toFixed(2); });
  $('amount').addEventListener('keydown', e => { if (e.key === 'Enter') $('note').focus(); });
  $('note').addEventListener('keydown', e => { if (e.key === 'Enter') addEntry(); });
  $('add').onclick = addEntry;

  $('pickDate').onclick = () => {
    const el = $('date');
    if (el.showPicker) { try { el.showPicker(); return; } catch (e) {} }
    el.style.position = 'static'; el.style.opacity = 1;
    el.style.width = 'auto'; el.style.height = 'auto';
    el.style.pointerEvents = 'auto'; el.removeAttribute('tabindex');
    el.focus(); el.click();
  };

  $('date').addEventListener('change', () => {
    $('dateLabel').textContent = prettyDate($('date').value);
    checkReady();
  });

  $('prev').onclick = () => { view.setDate(1); view.setMonth(view.getMonth() - 1); render(); };
  $('next').onclick = () => { view.setDate(1); view.setMonth(view.getMonth() + 1); render(); };

  function render() {
    const y = view.getFullYear(), m = view.getMonth();
    const inMonth = entries.filter(e => {
      const [ey, em] = e.date.split('-').map(Number);
      return ey === y && em === m + 1;
    }).sort((a, b) => a.date < b.date ? 1 : a.date > b.date ? -1 : 0);

    const today = localISO(new Date());
    $('todayTotal').textContent = money(entries.filter(e => e.date === today).reduce((s, e) => s + e.amount, 0));

    const now = new Date();
    const isThis = y === now.getFullYear() && m === now.getMonth();
    $('monthName').textContent = isThis ? 'This month' : MONTHS[m] + ' ' + y;
    const sum = inMonth.reduce((s, e) => s + e.amount, 0);
    $('monthTotal').textContent = money(sum);
    $('count').textContent = inMonth.length;
    $('next').disabled = y > now.getFullYear() || (y === now.getFullYear() && m >= now.getMonth());

    const bd = $('breakdown');
    bd.innerHTML = '';
    if (!inMonth.length) {
      bd.innerHTML = '<div class="empty">Nothing logged yet.</div>';
    } else {
      const totals = {};
      inMonth.forEach(e => { totals[e.category] = (totals[e.category] || 0) + e.amount; });
      CATEGORIES.filter(c => totals[c.id]).sort((a, b) => totals[b.id] - totals[a.id]).forEach(c => {
        const v = totals[c.id], pct = Math.round(v / sum * 100);
        const row = document.createElement('div');
        row.className = 'bd';
        row.style.setProperty('--c', c.colour);
        row.innerHTML =
          '<div class="ico">' + c.short + '</div>' +
          '<div class="mid"><div class="name">' + c.label + '</div>' +
          '<div class="track"><i style="width:' + Math.max(pct, 2) + '%"></i></div></div>' +
          '<div><div class="val">' + money(v) + '</div><div class="pct">' + pct + '%</div></div>';
        bd.appendChild(row);
      });
    }

    const list = $('list');
    list.innerHTML = '';
    if (!inMonth.length) list.innerHTML = '<div class="empty">Your entries for this month will show here.</div>';

    let day = null;
    inMonth.forEach(e => {
      if (e.date !== day) {
        day = e.date;
        const dayTotal = inMonth.filter(x => x.date === day).reduce((s, x) => s + x.amount, 0);
        const h = document.createElement('div');
        h.className = 'day';
        h.innerHTML = '<span>' + prettyDate(e.date) + '</span><span>' + money(dayTotal) + '</span>';
        list.appendChild(h);
      }
      const c = cat(e.category);
      const row = document.createElement('div');
      row.className = 'entry';
      row.style.setProperty('--c', c.colour);
      row.innerHTML =
        '<div class="ico">' + c.short + '</div>' +
        '<div class="mid"><div class="t">' + (e.note ? esc(e.note) : c.label) + '</div><div class="s">' + c.label + '</div></div>' +
        '<div class="amt">' + money(e.amount) + '</div>';
      const btn = document.createElement('button');
      if (confirming === e.id) {
        btn.className = 'confirm';
        btn.textContent = 'Remove';
        btn.onclick = () => { entries = entries.filter(x => x.id !== e.id); confirming = null; save(); render(); };
      } else {
        btn.className = 'kill';
        btn.innerHTML = '&times;';
        btn.setAttribute('aria-label', 'Remove entry');
        btn.onclick = () => { confirming = e.id; render(); };
      }
      row.appendChild(btn);
      list.appendChild(row);
    });

    $('expMonth').disabled = !inMonth.length;
    $('expAll').disabled = !entries.length;
  }

  /* ---------- CSV out ---------- */
  function toCSV(rows) {
    const q = v => { const s = String(v == null ? '' : v); return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s; };
    const lines = ['Date,Amount,Description,Category'];
    rows.slice().sort((a, b) => a.date < b.date ? -1 : a.date > b.date ? 1 : 0)
      .forEach(e => lines.push([q(e.date), e.amount.toFixed(2), q(e.note), q(cat(e.category).label)].join(',')));
    return lines.join('\r\n');
  }

  function download(rows, name) {
    const csv = toCSV(rows);
    try {
      const url = URL.createObjectURL(new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' }));
      const a = document.createElement('a');
      a.href = url; a.download = name;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 2000);
      $('hint').textContent = 'CSV downloaded. If nothing arrived, copy the text below instead.';
    } catch (err) {
      $('hint').textContent = 'Download blocked here. Copy the text below into a .csv file.';
    }
    $('csvout').classList.remove('hidden');
    $('csvout').value = csv;
  }

  $('expAll').onclick = () => download(entries, 'expenses-all-' + localISO(new Date()) + '.csv');
  $('expMonth').onclick = () => {
    const y = view.getFullYear(), m = view.getMonth();
    download(entries.filter(e => {
      const [ey, em] = e.date.split('-').map(Number);
      return ey === y && em === m + 1;
    }), 'expenses-' + y + '-' + String(m + 1).padStart(2, '0') + '.csv');
  };

  /* ---------- CSV in ---------- */
  function parseCSV(text) {
    const rows = [];
    let row = [], field = '', inQ = false;
    text = text.replace(/^\ufeff/, '');
    for (let i = 0; i < text.length; i++) {
      const ch = text[i];
      if (inQ) {
        if (ch === '"') { if (text[i + 1] === '"') { field += '"'; i++; } else inQ = false; }
        else field += ch;
      } else if (ch === '"') inQ = true;
      else if (ch === ',') { row.push(field); field = ''; }
      else if (ch === '\n') { row.push(field); rows.push(row); row = []; field = ''; }
      else if (ch !== '\r') field += ch;
    }
    if (field.length || row.length) { row.push(field); rows.push(row); }
    return rows.filter(r => r.some(c => c.trim() !== ''));
  }

  $('importBtn').onclick = () => $('importFile').click();

  $('importFile').onchange = ev => {
    const file = ev.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = () => {
      const rows = parseCSV(String(reader.result));
      if (!rows.length) { $('hint').textContent = 'That file looked empty.'; return; }
      const start = /date/i.test(rows[0][0]) ? 1 : 0;
      const seen = new Set(entries.map(e => e.date + '|' + e.amount + '|' + e.note + '|' + e.category));
      let added = 0, skipped = 0;
      for (let i = start; i < rows.length; i++) {
        const [date, amount, note, category] = rows[i];
        const amt = parseFloat(String(amount).replace(/[^0-9.]/g, ''));
        if (!/^\d{4}-\d{2}-\d{2}$/.test(String(date).trim()) || !isFinite(amt) || amt <= 0) { skipped++; continue; }
        const c = catByLabel(category) || CATEGORIES[6];
        const key = date.trim() + '|' + Math.round(amt * 100) / 100 + '|' + (note || '').trim() + '|' + c.id;
        if (seen.has(key)) { skipped++; continue; }
        seen.add(key);
        entries.push({
          id: Date.now() + '-' + Math.random().toString(36).slice(2, 7),
          date: date.trim(),
          amount: Math.round(amt * 100) / 100,
          note: (note || '').trim(),
          category: c.id
        });
        added++;
      }
      save(); render();
      $('hint').textContent = added + ' added' + (skipped ? ', ' + skipped + ' skipped as duplicates or invalid' : '') + '.';
      ev.target.value = '';
    };
    reader.readAsText(file);
  };

  /* ---------- Boot ---------- */
  try {
    const manifest = {
      name: 'Expenses', short_name: 'Expenses', start_url: '.',
      display: 'standalone', background_color: '#0E181D', theme_color: '#0E181D',
      icons: [{ src: 'data:image/png;base64,', sizes: '512x512', type: 'image/png', purpose: 'any' }]
    };
    const link = document.createElement('link');
    link.rel = 'manifest';
    link.href = URL.createObjectURL(new Blob([JSON.stringify(manifest)], { type: 'application/manifest+json' }));
    document.head.appendChild(link);
  } catch (e) {}

  $('date').value = localISO(new Date());
  load();
  render();
</script>
</body>
</html>
