  <input id="note" type="text" placeholder="What was it?" aria-label="What was it" maxlength="120" autocomplete="off">

  <div class="chips" id="chips" role="group" aria-label="Category"></div>

  <div class="actions">
    <button class="act primary" id="add" disabled>
      <span class="circle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
      <span>Add</span>
    </button>

    <button class="act" id="pickDate">
      <span class="circle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M8 3v4M16 3v4M3 10h18"/></svg></span>
      <span id="dateLabel">Today</span>
    </button>

    <button class="act" id="expMonth">
      <span class="circle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v11M7 11l5 5 5-5M5 20h14"/></svg></span>
      <span>Export</span>
    </button>
  </div>

  <input id="date" type="date" style="position:absolute;opacity:0;width:1px;height:1px;pointer-events:none" aria-label="Date" tabindex="-1">

  <div class="card">
    <div class="card-head">
      <h2 id="monthName">This month</h2>
      <div class="nav">
        <button id="prev" aria-label="Previous month">&#8249;</button>
        <span class="money" id="monthTotal">$0.00</span>
        <button id="next" aria-label="Next month">&#8250;</button>
